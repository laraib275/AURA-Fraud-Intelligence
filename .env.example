# Groq LLM API Configuration (Used by OpenAIClient for Copilot & AI Investigation)
# Get an API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# xAI Video Generation API Configuration (Optional - for AI Grok Imagine Video)
# Get an API key from https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# FastAPI Backend Configuration
API_HOST=127.0.0.1
API_PORT=8000
